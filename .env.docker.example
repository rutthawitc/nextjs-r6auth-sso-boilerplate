# Copy to .env.docker (git-ignored) for `docker compose up`.
# See .env.example for the full description of every variable.

# Host name "postgres" is the compose service.
DATABASE_URL=postgresql://pwa_auth:pwapass@postgres:5432/pwa_auth_db

# REQUIRED: random secret, at least 32 characters (openssl rand -base64 48)
IRON_SESSION_PASSWORD=change-me-to-a-random-string-of-at-least-32-chars
IRON_SESSION_COOKIE_NAME=pwa_auth_session
SESSION_MAX_LIFETIME=480
# true only behind a reverse proxy you control that overwrites X-Forwarded-For.
TRUST_PROXY=false

R6AUTH_URL=https://reg6apps.pwa.co.th/r6auth
R6AUTH_CLIENT_ID=my-app
# Secret from the app page on r6auth (shown once). Never commit it.
R6AUTH_CLIENT_SECRET=
R6AUTH_REDIRECT_URI=https://my-app.pwa.co.th/api/auth/sso/callback
R6AUTH_POST_LOGOUT_REDIRECT_URI=https://my-app.pwa.co.th/login
# Comma-separated BA codes allowed to sign in, e.g. 1059. Empty = anyone r6auth accepts.
R6AUTH_ALLOWED_BA=
R6AUTH_TIMEOUT=10

# Ignored in production images (NODE_ENV=production); do not rely on it.
R6AUTH_FAKE=false
