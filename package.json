{
  "name": "pwa-login-nextjs-sso",
  "description": "Next.js 16 + iron-session boilerplate with r6auth SSO (PWA = Provincial Waterworks Authority)",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "TMPDIR=.tmp vitest run",
    "create-local-admin": "tsx scripts/create-local-admin.ts",
    "seed-roles": "tsx scripts/seed-roles.ts",
    "seed-settings": "tsx scripts/seed-settings.ts",
    "seed-cost-centers": "tsx scripts/seed-cost-centers.ts",
    "db:migrate": "drizzle-kit migrate",
    "db-studio": "drizzle-kit studio",
    "r6auth:check": "tsx scripts/r6auth-check.ts",
    "build:scripts": "esbuild scripts/r6auth-check.ts --bundle --platform=node --format=esm --target=node22 --outdir=dist-scripts --out-extension:.js=.mjs --banner:js=\"import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\" --log-level=warning"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@swc/helpers": "0.5.23",
    "@tanstack/react-query": "^5.104.0",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "iron-session": "^8.0.4",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.24.0"
}
