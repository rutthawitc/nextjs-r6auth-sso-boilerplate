# Copy to .env.local for local development (pnpm dev / pnpm r6auth:check).
# Docker: copy .env.docker.example to .env.docker instead.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL connection string.
DATABASE_URL=postgresql://pwa_auth:pwapass@localhost:5432/pwa_auth_db

# ---------------------------------------------------------------------------
# Session (iron-session)
# ---------------------------------------------------------------------------
# REQUIRED: random secret of at least 32 characters. Generate with: openssl rand -base64 48
IRON_SESSION_PASSWORD=change-me-to-a-random-string-of-at-least-32-chars
# Cookie name (default: pwa_auth_session).
IRON_SESSION_COOKIE_NAME=pwa_auth_session
# Absolute session lifetime in minutes, counted from login (default: 480).
SESSION_MAX_LIFETIME=480
# true only when a reverse proxy YOU control overwrites X-Forwarded-For / X-Real-IP.
# Leave false when the app is reachable directly (the headers could be spoofed).
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# r6auth SSO (กปภ.ข.6)
# ---------------------------------------------------------------------------
# Register the app at {R6AUTH_URL}/apps.php with exactly these two URLs, wait
# for approval, then create the secret on the app page (shown once).
# `pnpm r6auth:check` prints the values to register and pings r6auth.
R6AUTH_URL=https://reg6apps.pwa.co.th/r6auth
R6AUTH_CLIENT_ID=my-app
# Server-side only. Never commit it, never expose it to the browser.
R6AUTH_CLIENT_SECRET=
# Must match the registered redirect_uri character for character.
R6AUTH_REDIRECT_URI=http://localhost:3000/api/auth/sso/callback
# Registered post_logout_redirect_uri: where r6auth sends users after logout.
R6AUTH_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/login
# Comma-separated BA codes allowed to sign in (e.g. 1059 = region 6 office).
# Empty = anyone with a PWA account. Checked before any user row is written.
R6AUTH_ALLOWED_BA=
# token.php timeout in seconds (default: 10).
R6AUTH_TIMEOUT=10
# r6auth uses a public (DigiCert) certificate, so no CA setup is needed. If a
# deployment ever uses an internal CA, set NODE_EXTRA_CA_CERTS=/path/ca.pem.
# Never disable certificate verification.

# DEVELOPMENT ONLY: built-in fake r6auth (users 10001/10002/10003 at /dev/sso;
# "จำลองระบบล่ม" simulates an outage). Ignored unless NODE_ENV is development or
# test, so it has no effect in a production build.
R6AUTH_FAKE=false
